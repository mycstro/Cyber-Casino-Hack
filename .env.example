# Copy to an untracked .env; run with node --env-file=.env --import tsx server/index.ts
HOST=127.0.0.1
PORT=3001
# Must exactly match the browser URL. Use http://localhost:5173 for Vite dev.
PUBLIC_ORIGIN=http://localhost:3001
DATABASE_PATH=server-data/game.sqlite
# Optional Meta applications. Never put secrets in VITE_* variables.
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
INSTAGRAM_CLIENT_ID=
INSTAGRAM_CLIENT_SECRET=
